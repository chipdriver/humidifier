  40:Services/Src/display_service.c **** /**
  41:Services/Src/display_service.c ****  * @brief 用整数 x10 格式化一行温湿度文本，避免 float printf。
  42:Services/Src/display_service.c ****  * @param buffer 输出缓冲区。
  43:Services/Src/display_service.c ****  * @param buffer_size 输出缓冲区大小。
  44:Services/Src/display_service.c ****  * @param label 行标题。
  45:Services/Src/display_service.c ****  * @param value_x10 放大 10 倍后的数值。
  46:Services/Src/display_service.c ****  * @param unit 单位字符串。
  47:Services/Src/display_service.c ****  * @retval 无
  48:Services/Src/display_service.c ****  */
  49:Services/Src/display_service.c **** static void DisplayService_FormatX10Line(char *buffer,
  50:Services/Src/display_service.c ****                                          uint32_t buffer_size,
  51:Services/Src/display_service.c ****                                          const char *label,
  52:Services/Src/display_service.c ****                                          int32_t value_x10,
  53:Services/Src/display_service.c ****                                          const char *unit)
  54:Services/Src/display_service.c **** {
  55:Services/Src/display_service.c ****   int32_t abs_x10 = value_x10;
  56:Services/Src/display_service.c ****   const char *sign = "";
  57:Services/Src/display_service.c **** 
  58:Services/Src/display_service.c ****   /* 参数无效时直接返回，避免访问空指针。 */
  59:Services/Src/display_service.c ****   if ((buffer == (char *)0) || (label == (const char *)0) || (unit == (const char *)0))
  60:Services/Src/display_service.c ****   {
  61:Services/Src/display_service.c ****     return;
  62:Services/Src/display_service.c ****   }
  63:Services/Src/display_service.c **** 
  64:Services/Src/display_service.c ****   /* 负数单独处理符号，保证小数位始终为正。 */
  65:Services/Src/display_service.c ****   if (abs_x10 < 0)
  66:Services/Src/display_service.c ****   {
  67:Services/Src/display_service.c ****     sign = "-";
  68:Services/Src/display_service.c ****     abs_x10 = -abs_x10;
  69:Services/Src/display_service.c ****   }
  70:Services/Src/display_service.c **** 
  71:Services/Src/display_service.c ****   /* 只用整数格式化，不依赖 STM32 printf 的 float 支持。 */
  72:Services/Src/display_service.c ****   (void)snprintf(buffer,
  73:Services/Src/display_service.c ****                  buffer_size,
  74:Services/Src/display_service.c ****                  "%s %s%ld.%ld %s",
  75:Services/Src/display_service.c ****                  label,
  76:Services/Src/display_service.c ****                  sign,
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccnysYXM.s 			page 4


  77:Services/Src/display_service.c ****                  (long)(abs_x10 / 10),
  78:Services/Src/display_service.c ****                  (long)(abs_x10 % 10),
  79:Services/Src/display_service.c ****                  unit);
  80:Services/Src/display_service.c **** }
  81:Services/Src/display_service.c **** 
  82:Services/Src/display_service.c **** /**
  83:Services/Src/display_service.c ****  * @brief 清除一行显示区域。
  84:Services/Src/display_service.c ****  * @param y 行起始 Y 坐标。
  85:Services/Src/display_service.c ****  * @retval 无
  86:Services/Src/display_service.c ****  */
  87:Services/Src/display_service.c **** static void DisplayService_ClearLine(uint16_t y)
  88:Services/Src/display_service.c **** {
  89:Services/Src/display_service.c ****   /* 用黑色矩形覆盖整行，避免较短文本留下旧字符。 */
  90:Services/Src/display_service.c ****   ST7789_FillRect(0U, y, ST7789_WIDTH, DISPLAY_LINE_H, ST7789_COLOR_BLACK);
  91:Services/Src/display_service.c **** }
  92:Services/Src/display_service.c **** 
  93:Services/Src/display_service.c **** /**
  94:Services/Src/display_service.c ****  * @brief 绘制一行英文状态文本。
  95:Services/Src/display_service.c ****  * @param y 行起始 Y 坐标。
  96:Services/Src/display_service.c ****  * @param text 要显示的字符串。
  97:Services/Src/display_service.c ****  * @param color RGB565 前景色。
  98:Services/Src/display_service.c ****  * @retval 无
  99:Services/Src/display_service.c ****  */
 100:Services/Src/display_service.c **** static void DisplayService_DrawLine(uint16_t y, const char *text, uint16_t color)
 101:Services/Src/display_service.c **** {
 102:Services/Src/display_service.c ****   /* 先清除本行旧内容。 */
 103:Services/Src/display_service.c ****   DisplayService_ClearLine(y);
 104:Services/Src/display_service.c **** 
 105:Services/Src/display_service.c ****   /* 再绘制新的 ASCII 文本。 */
 106:Services/Src/display_service.c ****   ST7789_DrawString(DISPLAY_TEXT_X, (uint16_t)(y + 2U), text, color, ST7789_COLOR_BLACK);
 107:Services/Src/display_service.c **** }
