 131:DeviceDrivers/LCD/Src/st7789.c **** /**
 132:DeviceDrivers/LCD/Src/st7789.c ****  * @brief 初始化 ST7789 屏幕控制器。
 133:DeviceDrivers/LCD/Src/st7789.c ****  * @retval 无
 134:DeviceDrivers/LCD/Src/st7789.c ****  */
 135:DeviceDrivers/LCD/Src/st7789.c **** void ST7789_Init(void)
 136:DeviceDrivers/LCD/Src/st7789.c **** {
 137:DeviceDrivers/LCD/Src/st7789.c ****   /* 初始化上一层硬件驱动使用的 GPIO 引脚。 */
 138:DeviceDrivers/LCD/Src/st7789.c ****   LCD_HW_GPIO_Init();
 139:DeviceDrivers/LCD/Src/st7789.c **** 
 140:DeviceDrivers/LCD/Src/st7789.c ****   /* 通过 RESET 引脚复位屏幕。 */
 141:DeviceDrivers/LCD/Src/st7789.c ****   LCD_Reset();
 142:DeviceDrivers/LCD/Src/st7789.c **** 
 143:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送退出睡眠模式命令。 */
 144:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteCmd(ST7789_CMD_SLPOUT);
 145:DeviceDrivers/LCD/Src/st7789.c **** 
 146:DeviceDrivers/LCD/Src/st7789.c ****   /* 等待屏幕从睡眠模式中稳定退出。 */
 147:DeviceDrivers/LCD/Src/st7789.c ****   HAL_Delay(120U);
 148:DeviceDrivers/LCD/Src/st7789.c **** 
 149:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送正常显示模式开启命令。 */
 150:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteCmd(ST7789_CMD_NORON);
 151:DeviceDrivers/LCD/Src/st7789.c **** 
 152:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送颜色格式设置命令。 */
 153:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteCmd(ST7789_CMD_COLMOD);
 154:DeviceDrivers/LCD/Src/st7789.c **** 
 155:DeviceDrivers/LCD/Src/st7789.c ****   /* 设置为 RGB565 / 16-bit 颜色格式。 */
 156:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteData(ST7789_COLMOD_16BIT);
 157:DeviceDrivers/LCD/Src/st7789.c **** 
 158:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送扫描方向设置命令。 */
 159:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteCmd(ST7789_CMD_MADCTL);
 160:DeviceDrivers/LCD/Src/st7789.c **** 
 161:DeviceDrivers/LCD/Src/st7789.c ****   /* 写入当前版本使用的扫描方向参数。 */
 162:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteData(ST7789_MADCTL_VALUE);
 163:DeviceDrivers/LCD/Src/st7789.c **** 
 164:DeviceDrivers/LCD/Src/st7789.c ****   /* 判断是否启用显示反色模式。 */
 165:DeviceDrivers/LCD/Src/st7789.c **** #if ST7789_USE_INVERSION
 166:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送显示反色开启命令。 */
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccJePjwJ.s 			page 5


 167:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteCmd(ST7789_CMD_INVON);
 168:DeviceDrivers/LCD/Src/st7789.c **** #else
 169:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送显示反色关闭命令。 */
