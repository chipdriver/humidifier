 172:DeviceDrivers/LCD/Src/st7789.c **** 
 173:DeviceDrivers/LCD/Src/st7789.c ****   /* 发送开启显示命令。 */
 174:DeviceDrivers/LCD/Src/st7789.c ****   LCD_WriteCmd(ST7789_CMD_DISPON);
 175:DeviceDrivers/LCD/Src/st7789.c **** 
 176:DeviceDrivers/LCD/Src/st7789.c ****   /* 等待显示开启后稳定。 */
 177:DeviceDrivers/LCD/Src/st7789.c ****   HAL_Delay(20U);
 178:DeviceDrivers/LCD/Src/st7789.c **** 
