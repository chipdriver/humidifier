 324:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** int32_t lv_anim_path_bounce(const lv_anim_t * a)
 325:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** {
 326:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     /*Calculate the current step*/
 327:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     int32_t t = lv_map(a->act_time, 0, a->duration, 0, LV_BEZIER_VAL_MAX);
 328:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     int32_t diff = (a->end_value - a->start_value);
 329:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 330:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     /*3 bounces has 5 parts: 3 down and 2 up. One part is t / 5 long*/
 331:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 332:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(t < 408) {
 333:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         /*Go down*/
 334:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t = (t * 2500) >> LV_BEZIER_VAL_SHIFT; /*[0..1024] range*/
 335:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t = LV_BEZIER_VAL_MAX - t;
 336:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 337:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     else if(t >= 408 && t < 614) {
 338:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         /*First bounce back*/
 339:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t -= 408;
 340:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t    = t * 5; /*to [0..1024] range*/
 341:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         diff = diff / 20;
 342:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 343:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     else if(t >= 614 && t < 819) {
 344:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         /*Fall back*/
 345:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t -= 614;
 346:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t    = t * 5; /*to [0..1024] range*/
 347:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t    = LV_BEZIER_VAL_MAX - t;
 348:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         diff = diff / 20;
 349:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 350:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     else if(t >= 819 && t < 921) {
 351:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         /*Second bounce back*/
 352:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t -= 819;
 353:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t    = t * 10; /*to [0..1024] range*/
 354:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         diff = diff / 40;
 355:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 356:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     else if(t >= 921 && t <= LV_BEZIER_VAL_MAX) {
 357:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         /*Fall back*/
 358:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t -= 921;
 359:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t    = t * 10; /*to [0..1024] range*/
 360:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         t    = LV_BEZIER_VAL_MAX - t;
 361:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         diff = diff / 40;
 362:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 363:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 364:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(t > LV_BEZIER_VAL_MAX) t = LV_BEZIER_VAL_MAX;
 365:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(t < 0) t = 0;
 366:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     int32_t step = lv_bezier3(t, 0, 500, 800, LV_BEZIER_VAL_MAX);
 367:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 368:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     int32_t new_value;
 369:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     new_value = step * diff;
 370:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     new_value = new_value >> LV_BEZIER_VAL_SHIFT;
 371:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     new_value = a->end_value - new_value;
 372:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccKUNV1D.s 			page 8


 373:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     return new_value;
 374:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** }
 375:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 376:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** int32_t lv_anim_path_step(const lv_anim_t * a)
 377:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** {
 378:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(a->act_time >= a->duration)
 379:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         return a->end_value;
