 256:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 257:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     /*Lower the resolution to fit the 0.1023 range*/
 258:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     speed = (speed + 5) / 10;
