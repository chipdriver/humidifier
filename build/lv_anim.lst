 252:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(max_time > 10000) {
 253:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         LV_LOG_WARN("max_time is truncated to 10000 (was %"LV_PRIu32")", max_time);
 254:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         max_time = 10230;
