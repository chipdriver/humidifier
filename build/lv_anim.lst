 186:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** bool lv_anim_delete(void * var, lv_anim_exec_xcb_t exec_cb)
 187:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** {
 188:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     lv_anim_t * a;
 189:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     bool del_any = false;
 190:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     a        = lv_ll_get_head(anim_ll_p);
 191:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     while(a != NULL) {
 192:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         bool del = false;
 193:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         if((a->var == var || var == NULL) && (a->exec_cb == exec_cb || exec_cb == NULL)) {
 194:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****             remove_anim(a);
 195:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****             anim_mark_list_change(); /*Read by `anim_timer`. It need to know if a delete occurred i
 196:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****                                        the linked list*/
 197:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****             del_any = true;
 198:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****             del = true;
 199:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         }
 200:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 201:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         /*Always start from the head on delete, because we don't know
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccKUNV1D.s 			page 5


 202:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****          *how `anim_ll_p` was changes in `a->deleted_cb` */
 203:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         a = del ? lv_ll_get_head(anim_ll_p) : lv_ll_get_next(anim_ll_p, a);
 204:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 205:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 206:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     return del_any;
 207:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** }
