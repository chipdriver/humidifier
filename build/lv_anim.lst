 172:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** uint32_t lv_anim_get_playtime(const lv_anim_t * a)
 173:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** {
 174:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(a->repeat_cnt == LV_ANIM_REPEAT_INFINITE) {
 175:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****         return LV_ANIM_PLAYTIME_INFINITE;
 176:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     }
 177:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 178:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t repeat_cnt = a->repeat_cnt;
 179:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if(repeat_cnt < 1) repeat_cnt = 1;
 180:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 181:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t playtime = a->repeat_delay + a->duration + a->reverse_delay + a->reverse_duration;
 182:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     playtime = playtime * repeat_cnt;
 183:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     return playtime;
 184:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** }
