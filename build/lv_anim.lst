 522:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** uint32_t lv_anim_resolve_speed(uint32_t speed_or_time, int32_t start, int32_t end)
 523:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** {
 524:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     /*It was a simple time*/
 525:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     if((speed_or_time & LV_ANIM_SPEED_MASK) == 0) return speed_or_time;
 526:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 527:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t d    = LV_ABS(start - end);
 528:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t speed = speed_or_time & 0x3FF;
 529:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t time = (d * 100) / speed; /*Speed is in 10 units per sec*/
 530:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t max_time = (speed_or_time >> 20) & 0x3FF;
 531:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     uint32_t min_time = (speed_or_time >> 10) & 0x3FF;
 532:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 533:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     return LV_CLAMP(min_time * 10, time, max_time * 10);
 534:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** }
