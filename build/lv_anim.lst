 259:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     min_time = (min_time + 5) / 10;
 260:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     max_time = (max_time + 5) / 10;
 261:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 262:Middlewares/LVGL/lvgl/src/misc/lv_anim.c ****     return LV_ANIM_SPEED_MASK + (max_time << 20) + (min_time << 10) + speed;
 263:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** 
 264:Middlewares/LVGL/lvgl/src/misc/lv_anim.c **** }
