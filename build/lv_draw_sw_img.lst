 348:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** /**
 349:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * Convert a RGB565 color to RGB888
 350:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * @param c       a RGB565 color on lv_color16_t
 351:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * @return        the color
 352:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  */
 353:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** static inline lv_color_t lv_color16_to_color(lv_color16_t c)
 354:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** {
 355:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****     return lv_color_make(c.red << 3, c.green << 2, c.blue << 3);
 356:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** }
 357:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** 
 358:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** /**
 359:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * Convert am RGB888 color to RGB565 stored in `uint16_t`
