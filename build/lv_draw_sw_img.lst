 372:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** /**
 373:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * Mix two RGB565 colors
 374:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * @param c1        the first color (typically the foreground color)
