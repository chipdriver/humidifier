 361:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  * @return          `color` as RGB565 on `uin16_t`
 362:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h ****  */
 363:Middlewares/LVGL/lvgl/src/draw/sw/blend/../../../misc/lv_color.h **** uint16_t lv_color_to_u16(lv_color_t color);
