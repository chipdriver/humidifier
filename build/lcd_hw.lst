  23:HardwareDrivers/LCD/Src/lcd_hw.c **** /**
  24:HardwareDrivers/LCD/Src/lcd_hw.c ****  * @brief 初始化 LCD 使用的 GPIO 引脚，并设置默认电平。
  25:HardwareDrivers/LCD/Src/lcd_hw.c ****  * @retval 无
  26:HardwareDrivers/LCD/Src/lcd_hw.c ****  */
  27:HardwareDrivers/LCD/Src/lcd_hw.c **** void LCD_HW_GPIO_Init(void)
  28:HardwareDrivers/LCD/Src/lcd_hw.c **** {
  29:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 定义并清零 HAL GPIO 初始化结构体。 */
  30:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitTypeDef GPIO_InitStruct = {0};
  31:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  32:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 使用 PB10/PB11/PB12/PB13/PB15 之前，先使能 GPIOB 外设时钟。 */
  33:HardwareDrivers/LCD/Src/lcd_hw.c ****   __HAL_RCC_GPIOB_CLK_ENABLE();
  34:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  35:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 选择 RESET、DC、CS 这 3 个控制引脚，准备配置为中速输出。 */
  36:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Pin = LCD_RESET_PIN | LCD_DC_PIN | LCD_CS_PIN;
  37:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  38:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 将选中的引脚配置为推挽输出模式。 */
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccpDRViC.s 			page 3


  39:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  40:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  41:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 不启用芯片内部上拉或下拉电阻。 */
  42:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Pull = GPIO_NOPULL;
  43:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  44:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 控制引脚使用中速即可。 */
  45:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_MEDIUM;
  46:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  47:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 将上面的配置写入 GPIOB。 */
  48:HardwareDrivers/LCD/Src/lcd_hw.c ****   HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);
  49:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  50:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 选择 SCK 和 MOSI 这 2 个软件 SPI 引脚，准备配置为高速输出。 */
  51:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Pin = LCD_SCK_PIN | LCD_MOSI_PIN;
  52:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  53:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 继续使用推挽输出模式。 */
  54:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  55:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  56:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 继续不启用芯片内部上拉或下拉电阻。 */
  57:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Pull = GPIO_NOPULL;
  58:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  59:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* SCK 和 MOSI 属于软件 SPI 时序引脚，建议使用高速。 */
  60:HardwareDrivers/LCD/Src/lcd_hw.c ****   GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
  61:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  62:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 将上面的配置写入 GPIOB。 */
  63:HardwareDrivers/LCD/Src/lcd_hw.c ****   HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);
  64:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  65:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 初始化完成后，RESET 默认保持高电平。 */
  66:HardwareDrivers/LCD/Src/lcd_hw.c ****   LCD_RESET_High();
  67:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  68:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 初始化完成后，CS 默认保持高电平，表示不选中屏幕。 */
  69:HardwareDrivers/LCD/Src/lcd_hw.c ****   LCD_CS_High();
  70:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  71:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 初始化完成后，DC 默认保持低电平，表示命令模式。 */
  72:HardwareDrivers/LCD/Src/lcd_hw.c ****   LCD_DC_Low();
  73:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  74:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 初始化完成后，SCK 默认保持低电平，软件 SPI 空闲低。 */
  75:HardwareDrivers/LCD/Src/lcd_hw.c ****   LCD_SCK_Low();
  76:HardwareDrivers/LCD/Src/lcd_hw.c **** 
  77:HardwareDrivers/LCD/Src/lcd_hw.c ****   /* 初始化完成后，MOSI 默认保持低电平。 */
  78:HardwareDrivers/LCD/Src/lcd_hw.c ****   LCD_MOSI_Low();
  79:HardwareDrivers/LCD/Src/lcd_hw.c **** }
