 475:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****     for(i = child_cnt - 1; i >= 0; i--) {
 476:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****         lv_obj_t * child = obj->spec_attr->children[i];
 477:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****         found_p = lv_refr_get_top_obj(area_p, child);
 478:Middlewares/LVGL/lvgl/src/core/lv_refr.c **** 
 479:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****         /*If a children is ok then break*/
 480:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****         if(found_p != NULL) {
 481:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****             break;
 482:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****         }
 483:Middlewares/LVGL/lvgl/src/core/lv_refr.c ****     }
 484:Middlewares/LVGL/lvgl/src/core/lv_refr.c **** 
