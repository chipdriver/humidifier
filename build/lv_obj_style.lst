 752:Middlewares/LVGL/lvgl/src/core/lv_obj_style.c ****  */
 753:Middlewares/LVGL/lvgl/src/core/lv_obj_style.c **** static lv_style_t * get_local_style(lv_obj_t * obj, lv_style_selector_t selector)
 754:Middlewares/LVGL/lvgl/src/core/lv_obj_style.c **** {
