 202:Middlewares/LVGL/lvgl/src/widgets/slider/lv_slider.c **** lv_slider_orientation_t lv_slider_get_orientation(lv_obj_t * slider)
 203:Middlewares/LVGL/lvgl/src/widgets/slider/lv_slider.c **** {
 204:Middlewares/LVGL/lvgl/src/widgets/slider/lv_slider.c ****     lv_bar_orientation_t ori = lv_bar_get_orientation(slider);
