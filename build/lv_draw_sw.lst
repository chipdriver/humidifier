 321:Middlewares/LVGL/lvgl/src/draw/sw/lv_draw_sw.c ****     }
 322:Middlewares/LVGL/lvgl/src/draw/sw/lv_draw_sw.c **** 
 323:Middlewares/LVGL/lvgl/src/draw/sw/lv_draw_sw.c ****     void * buf = lv_draw_layer_alloc_buf(layer);
 324:Middlewares/LVGL/lvgl/src/draw/sw/lv_draw_sw.c ****     if(buf == NULL) {
 325:Middlewares/LVGL/lvgl/src/draw/sw/lv_draw_sw.c ****         LV_PROFILER_DRAW_END;
