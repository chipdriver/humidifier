 150:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_PROP_INV               = 0,
 151:Middlewares/LVGL/lvgl/src/misc/lv_style.h **** 
 152:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     /*The properties are listed in a special order to make caching more effective.
 153:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *Groups are used when LV_OBJ_STYLE_CACHE is enabled.
 154:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *If a property from a groups is set, a bit will be set in
 155:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *obj->style_main_prop_is_set and style_other_prop_is_set
 156:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *to indicate that the property is set.
 157:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *
 158:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *Strategy 1: group related properties. E.g. if no "border" properties are set
 159:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *            they will be skipped quickly.
 160:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *
 161:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *Strategy 2: group common property with rarely used properties. This way
 162:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *            the common property is cached properly and it's rarely affected
 163:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *            by other props. The other props are cached in an sub-optimal way,
 164:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *            but they are used rarely.
 165:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *
 166:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *Strategy 3: group properties they are used rarely together so that caching doesn't
 167:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *            interfere
 168:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *
 169:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****      *Each group can have 8 properties. (see STYLE_PROP_SHIFTED)*/
 170:Middlewares/LVGL/lvgl/src/misc/lv_style.h **** 
 171:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     /* Size related properties*/
 172:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_WIDTH = 1,
 173:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_HEIGHT,
 174:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_LENGTH,
 175:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_TRANSFORM_WIDTH,
 176:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_TRANSFORM_HEIGHT,
 177:Middlewares/LVGL/lvgl/src/misc/lv_style.h **** 
 178:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_MIN_WIDTH = 8,
 179:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_MAX_WIDTH,
 180:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_MIN_HEIGHT,
 181:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_MAX_HEIGHT,
 182:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_TRANSLATE_X,
 183:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_TRANSLATE_Y,
 184:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_RADIAL_OFFSET,
 185:Middlewares/LVGL/lvgl/src/misc/lv_style.h **** 
 186:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     /*Position related properties */
 187:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_X = 16,
 188:Middlewares/LVGL/lvgl/src/misc/lv_style.h ****     LV_STYLE_Y,
