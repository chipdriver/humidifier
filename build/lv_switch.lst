 181:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c **** 
 182:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         if(diff & LV_STATE_CHECKED) {
 183:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****             lv_switch_trigger_anim(obj);
 184:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****             lv_obj_invalidate(obj);
 185:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         }
 186:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     }
 187:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     else if(code == LV_EVENT_DRAW_MAIN) {
