 155:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c **** 
 156:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     /*Call the ancestor's event handler*/
 157:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     res = lv_obj_event_base(MY_CLASS, e);
 158:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     if(res != LV_RESULT_OK) return;
 159:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c **** 
 160:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     lv_event_code_t code = lv_event_get_code(e);
 161:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     lv_obj_t * obj = lv_event_get_current_target(e);
 162:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c **** 
 163:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     if(code == LV_EVENT_REFR_EXT_DRAW_SIZE) {
 164:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         int32_t knob_left = lv_obj_get_style_pad_left(obj,   LV_PART_KNOB);
 165:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         int32_t knob_right = lv_obj_get_style_pad_right(obj,  LV_PART_KNOB);
 166:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         int32_t knob_top = lv_obj_get_style_pad_top(obj,    LV_PART_KNOB);
 167:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         int32_t knob_bottom = lv_obj_get_style_pad_bottom(obj, LV_PART_KNOB);
 168:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c **** 
 169:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         /*The smaller size is the knob diameter*/
 170:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         int32_t knob_size = LV_MAX4(knob_left, knob_right, knob_bottom, knob_top);
 171:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         knob_size += LV_SWITCH_KNOB_EXT_AREA_CORRECTION;
 172:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         knob_size += lv_obj_calculate_ext_draw_size(obj, LV_PART_KNOB);
 173:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c **** 
 174:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         int32_t * s = lv_event_get_param(e);
 175:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         *s = LV_MAX(*s, knob_size);
 176:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****         *s = LV_MAX(*s, lv_obj_calculate_ext_draw_size(obj, LV_PART_INDICATOR));
 177:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     }
 178:Middlewares/LVGL/lvgl/src/widgets/switch/lv_switch.c ****     else if(code == LV_EVENT_STATE_CHANGED) {
