 581:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** /**
 582:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****  * Check if there are older draw task overlapping the area of `t_check`
 583:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****  * @param layer         the draw ctx to search in
 584:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****  * @param t_check       check this task if it overlaps with the older ones
 585:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****  * @param draw_unit_id  draw unit ID for which the independence check is called
 586:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****  * @return              true: `t_check` is not overlapping with older tasks so it's independent
 587:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****  */
 588:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** static bool is_independent(lv_layer_t * layer, lv_draw_task_t * t_check, uint8_t draw_unit_id)
 589:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** {
 590:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     LV_PROFILER_DRAW_BEGIN;
 591:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     lv_draw_task_t * t = layer->draw_task_head;
 592:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** 
 593:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     /*If t_check is outside of the older tasks then it's independent*/
 594:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     while(t && t != t_check) {
 595:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         /*It's independent of finished draw tasks, and queued draw tasks of the same draw unit,
 596:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****          *so no need to check it*/
 597:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         if(t->state == LV_DRAW_TASK_STATE_FINISHED ||
 598:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****            (t->state == LV_DRAW_TASK_STATE_QUEUED && t->preferred_draw_unit_id == draw_unit_id)) {
 599:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****             t = t->next;
 600:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****             continue;
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccMPVKOL.s 			page 12


 601:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         }
 602:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** 
 603:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         lv_area_t a;
 604:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         if(lv_area_intersect(&a, &t->_real_area, &t_check->_real_area)) {
 605:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****             LV_PROFILER_DRAW_END;
 606:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****             return false;
 607:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         }
 608:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****         t = t->next;
 609:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     }
 610:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     LV_PROFILER_DRAW_END;
 611:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** 
 612:Middlewares/LVGL/lvgl/src/draw/lv_draw.c ****     return true;
 613:Middlewares/LVGL/lvgl/src/draw/lv_draw.c **** }
