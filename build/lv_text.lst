 497:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 498:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     pos = lv_text_encoded_get_byte_id(txt, pos); /*Convert to byte index instead of letter index*/
 499:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     len = lv_text_encoded_get_byte_id(&txt[pos], len);
 500:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 501:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     /*Copy the second part into the end to make place to text to insert*/
