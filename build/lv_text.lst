 145:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 146:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         size_res->x = LV_MAX(act_line_length, size_res->x);
 147:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         line_start  = new_line_start;
 148:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     }
 149:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 150:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     /*Make the text one line taller if the last character is '\n' or '\r'*/
 151:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if((line_start != 0) && (text[line_start - 1] == '\n' || text[line_start - 1] == '\r')) {
