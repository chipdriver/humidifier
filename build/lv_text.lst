 167:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         if(*state == LV_TEXT_CMD_STATE_WAIT) { /*Start char*/
 168:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             *state = LV_TEXT_CMD_STATE_PAR;
