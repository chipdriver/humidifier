 154:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 155:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     /*Correction with the last line space or set the height manually if the text is empty*/
 156:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if(size_res->y == 0)
 157:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         size_res->y = letter_height;
 158:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     else
