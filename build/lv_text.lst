 170:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         }
 171:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         /*Other start char in parameter is escaped cmd. char*/
 172:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         else if(*state == LV_TEXT_CMD_STATE_WAIT) {
 173:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             *state = LV_TEXT_CMD_STATE_WAIT;
 174:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         }
 175:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         /*Command end*/
