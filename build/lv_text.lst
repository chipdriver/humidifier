 504:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         txt[i] = txt[i + len];
 505:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     }
 506:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** }
