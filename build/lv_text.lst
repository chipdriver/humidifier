 615:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** /**
 616:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * Convert a wide character, e.g. 'Á' little endian to be UTF-8 compatible
 617:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param c a wide character or a  Little endian number
 618:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @return `c` in big endian
 619:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  */
 620:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** static uint32_t lv_text_utf8_conv_wc(uint32_t c)
 621:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** {
 622:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** #if LV_BIG_ENDIAN_SYSTEM == 0
 623:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     /*Swap the bytes (UTF-8 is big endian, but the MCUs are little endian)*/
 624:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if((c & 0x80) != 0) {
 625:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         uint32_t swapped;
 626:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         uint8_t c8[4];
 627:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         lv_memcpy(c8, &c, 4);
 628:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         swapped = (c8[0] << 24) + (c8[1] << 16) + (c8[2] << 8) + (c8[3]);
 629:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         uint8_t i;
 630:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         for(i = 0; i < 4; i++) {
 631:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             if((swapped & 0xFF) == 0)
 632:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****                 swapped = (swapped >> 8); /*Ignore leading zeros (they were in the end originally)*
 633:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         }
 634:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         c = swapped;
 635:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     }
 636:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** #endif
 637:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     return c;
 638:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** }
 639:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
