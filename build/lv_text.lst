 162:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** bool lv_text_is_cmd(lv_text_cmd_state_t * state, uint32_t c)
 163:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** {
 164:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     bool ret = false;
