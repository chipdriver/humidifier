 231:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 232:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if(flag & LV_TEXT_FLAG_EXPAND) max_width = LV_COORD_MAX;
