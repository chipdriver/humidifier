 193:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** /**
 194:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * Get the next word of text. A word is delimited by break characters.
 195:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 196:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * If the word cannot fit in the max_width space, obey LV_TXT_LINE_BREAK_LONG_* rules.
 197:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 198:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * If the next word cannot fit anything, return 0.
 199:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 200:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * If the first character is a break character, returns the next index.
 201:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 202:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * Example calls from lv_text_get_next_line() assuming sufficient max_width and
 203:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * txt = "Test text\n"
 204:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *        0123456789
 205:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 206:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * Calls would be as follows:
 207:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *     1. Return i=4, pointing at breakchar ' ', for the string "Test"
 208:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *     2. Return i=5, since i=4 was a breakchar.
 209:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *     3. Return i=9, pointing at breakchar '\n'
 210:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *     4. Parenting lv_text_get_next_line() would detect subsequent '\0'
 211:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 212:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * TODO: Returned word_w_ptr may overestimate the returned word's width when
 213:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * max_width is reached. In current usage, this has no impact.
 214:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  *
 215:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param txt a '\0' terminated string
 216:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param font pointer to a font
 217:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param letter_space letter space
 218:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param max_width max width of the text (break the lines to fit this size). Set COORD_MAX to avoi
 219:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param flags settings for the text from 'txt_flag_type' enum
 220:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param[out] word_w_ptr width (in pixels) of the parsed word. May be NULL.
 221:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @param cmd_state Pointer to a lv_text_cmd_state_t variable which stored the current state of com
 222:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  * @return the index of the first char of the next word (in byte index not letter index. With UTF-8
 223:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****  */
 224:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** static uint32_t lv_text_get_next_word(const char * txt, const lv_font_t * font,
 225:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****                                       int32_t letter_space, int32_t max_width,
 226:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****                                       lv_text_flag_t flag, uint32_t * word_w_ptr,
 227:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****                                       lv_text_cmd_state_t * cmd_state)
 228:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** {
 229:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if(txt == NULL || txt[0] == '\0') return 0;
