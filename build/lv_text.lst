 176:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         else if(*state == LV_TEXT_CMD_STATE_IN) {
 177:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             *state = LV_TEXT_CMD_STATE_WAIT;
 178:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             ret = true;
 179:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         }
 180:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     }
 181:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 182:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     /*Skip the color parameter and wait the space after it*/
 183:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if(*state == LV_TEXT_CMD_STATE_PAR) {
 184:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         if(c == ' ') {
 185:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             *state = LV_TEXT_CMD_STATE_IN; /*After the parameter the text is in the command*/
 186:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         }
 187:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         ret = true;
 188:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     }
 189:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 190:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     return ret;
 191:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** }
