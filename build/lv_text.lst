 139:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****             size_res->y += attributes->line_space;
 140:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         }
 141:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
 142:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         /*Calculate the longest line*/
 143:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****         int32_t act_line_length = lv_text_get_width(
