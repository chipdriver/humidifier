 492:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** void lv_text_cut(char * txt, uint32_t pos, uint32_t len)
 493:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** {
 494:Middlewares/LVGL/lvgl/src/misc/lv_text.c ****     if(txt == NULL) return;
 495:Middlewares/LVGL/lvgl/src/misc/lv_text.c **** 
