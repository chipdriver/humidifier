 618:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** lv_obj_t * lv_indev_search_obj(lv_obj_t * obj, lv_point_t * point)
 619:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** {
 620:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     lv_obj_t * found_p = NULL;
 621:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 622:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     /*If this obj is hidden the children are hidden too so return immediately*/
 623:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     if(lv_obj_has_flag(obj, LV_OBJ_FLAG_HIDDEN)) return NULL;
 624:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 625:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     lv_point_t p_trans = *point;
 626:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     lv_obj_transform_point(obj, &p_trans, LV_OBJ_POINT_TRANSFORM_FLAG_INVERSE);
 627:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 628:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     bool hit_test_ok = lv_obj_hit_test(obj, &p_trans);
 629:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 630:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     /*If the point is on this object check its children too*/
 631:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     lv_area_t obj_coords = obj->coords;
 632:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     if(lv_obj_has_flag(obj, LV_OBJ_FLAG_OVERFLOW_VISIBLE)) {
 633:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         int32_t ext_draw_size = lv_obj_get_ext_draw_size(obj);
 634:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         lv_area_increase(&obj_coords, ext_draw_size, ext_draw_size);
 635:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     }
 636:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     if(lv_area_is_point_on(&obj_coords, &p_trans, 0)) {
 637:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         int32_t i;
 638:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         uint32_t child_cnt = lv_obj_get_child_count(obj);
 639:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 640:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         /*If a child matches use it*/
 641:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         for(i = child_cnt - 1; i >= 0; i--) {
 642:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****             lv_obj_t * child = obj->spec_attr->children[i];
 643:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****             found_p = lv_indev_search_obj(child, &p_trans);
 644:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****             if(found_p) return found_p;
 645:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         }
 646:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     }
 647:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 648:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     /*If not return earlier for a clicked child and this obj's hittest was ok use it
 649:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****      *else return NULL*/
 650:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     if(hit_test_ok) return obj;
