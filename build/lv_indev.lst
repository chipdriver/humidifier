 279:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         }
 280:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         else if(indev->type == LV_INDEV_TYPE_ENCODER) {
 281:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****             indev_encoder_proc(indev, &data);
 282:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         }
 283:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         else if(indev->type == LV_INDEV_TYPE_BUTTON) {
