 230:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** {
 231:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     if(indev == NULL) return;
 232:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 233:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     LV_TRACE_INDEV("begin");
 234:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 235:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     indev_act = indev;
 236:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
 237:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     /*Read and process all indevs*/
 238:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****     if(indev->disp == NULL) return; /*Not assigned to any displays*/
 239:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
