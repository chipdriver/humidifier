 259:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         /*The active object might be deleted even in the read function*/
 260:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         indev_proc_reset_query_handler(indev);
 261:Middlewares/LVGL/lvgl/src/indev/lv_indev.c ****         indev_obj_act = NULL;
 262:Middlewares/LVGL/lvgl/src/indev/lv_indev.c **** 
