 324:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_range(lv_obj_t * obj, int32_t min, int32_t max)
 325:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** {
 326:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 327:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 328:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 329:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->min_value == min && arc->max_value == max) return;
 330:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 331:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->min_value = min;
 332:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->max_value = max;
 333:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 334:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value < min) {
 335:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****         arc->value = min;
 336:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     }
 337:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value > max) {
 338:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****         arc->value = max;
 339:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     }
 340:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 341:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     value_update(obj); /*value has changed relative to the new range*/
 342:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** }
 343:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
