 162:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_start_angle(lv_obj_t * obj, lv_value_precise_t start)
 163:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** {
 164:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 165:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 166:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 167:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(start > 360) start -= 360;
 168:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 169:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t old_delta = arc->indic_angle_end - arc->indic_angle_start;
 170:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t new_delta = arc->indic_angle_end - start;
 171:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 172:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(old_delta < 0) old_delta = 360 + old_delta;
 173:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(new_delta < 0) new_delta = 360 + new_delta;
 174:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 175:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(LV_ABS(new_delta - old_delta) > 180)  lv_obj_invalidate(obj);
 176:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     else if(new_delta < old_delta) inv_arc_area(obj, arc->indic_angle_start, start, LV_PART_INDICAT
 177:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     else if(old_delta < new_delta) inv_arc_area(obj, start, arc->indic_angle_start, LV_PART_INDICAT
 178:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 179:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     inv_knob_area(obj);
 180:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 181:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->indic_angle_start = start;
 182:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 183:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     inv_knob_area(obj);
 184:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** }
