 265:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_rotation(lv_obj_t * obj, int32_t rotation)
 266:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** {
 267:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
