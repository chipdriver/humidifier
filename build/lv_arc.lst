 269:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 270:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     /* ensure the angle is in the range [0, 360) */
 271:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     while(rotation < 0) rotation += 360;
 272:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     while(rotation >= 360) rotation -= 360;
 273:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->rotation = rotation;
