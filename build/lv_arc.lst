 227:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 228:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(LV_ABS(new_delta - old_delta) > 180)  lv_obj_invalidate(obj);
