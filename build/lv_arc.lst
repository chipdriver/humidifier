 219:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 220:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(start > 360) start -= 360;
 221:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 222:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t old_delta = arc->bg_angle_end - arc->bg_angle_start;
 223:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t new_delta = arc->bg_angle_end - start;
 224:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
