 278:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_mode(lv_obj_t * obj, lv_arc_mode_t type)
 279:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** {
 280:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 281:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 282:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 283:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     int32_t val = arc->value;
 284:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 285:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->type = type;
 286:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->value = -1; /** Force set_value handling*/
 287:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 288:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_value_precise_t bg_midpoint, bg_end = arc->bg_angle_end;
 289:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->bg_angle_end < arc->bg_angle_start) bg_end = arc->bg_angle_end + 360;
 290:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 291:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     switch(arc->type) {
 292:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****         case LV_ARC_MODE_SYMMETRICAL:
 293:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             bg_midpoint = (arc->bg_angle_start + bg_end) / 2;
 294:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             lv_arc_set_start_angle(obj, bg_midpoint);
 295:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             lv_arc_set_end_angle(obj, bg_midpoint);
 296:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             break;
 297:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****         case LV_ARC_MODE_REVERSE:
 298:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             lv_arc_set_end_angle(obj, arc->bg_angle_end);
 299:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             break;
 300:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****         default: /** LV_ARC_TYPE_NORMAL*/
 301:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****             lv_arc_set_start_angle(obj, arc->bg_angle_start);
 302:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     }
 303:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 304:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_set_value(obj, val);
 305:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** }
 306:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 307:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** void lv_arc_set_value(lv_obj_t * obj, int32_t value)
 308:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** {
 309:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     LV_ASSERT_OBJ(obj, MY_CLASS);
 310:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     lv_arc_t * arc = (lv_arc_t *)obj;
 311:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 312:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value == value) return;
 313:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 314:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     int32_t new_value;
 315:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     new_value = value > arc->max_value ? arc->max_value : value;
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccltMC5k.s 			page 7


 316:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     new_value = new_value < arc->min_value ? arc->min_value : new_value;
 317:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 318:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     if(arc->value == new_value) return;
 319:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     arc->value = new_value;
 320:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** 
 321:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c ****     value_update(obj);
 322:Middlewares/LVGL/lvgl/src/widgets/arc/lv_arc.c **** }
