  73:DeviceDrivers/Sensor/Src/aht20.c ****     }
  74:DeviceDrivers/Sensor/Src/aht20.c ****   }
  75:DeviceDrivers/Sensor/Src/aht20.c **** 
  76:DeviceDrivers/Sensor/Src/aht20.c ****   /* 状态检查通过，AHT20 初始化成功。 */
  77:DeviceDrivers/Sensor/Src/aht20.c ****   return AHT20_OK;
