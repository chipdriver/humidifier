  53:DeviceDrivers/Sensor/Src/aht20.c ****     {
  54:DeviceDrivers/Sensor/Src/aht20.c ****       /* 初始化命令发送失败，直接返回错误。 */
  55:DeviceDrivers/Sensor/Src/aht20.c ****       return AHT20_ERROR;
  56:DeviceDrivers/Sensor/Src/aht20.c ****     }
  57:DeviceDrivers/Sensor/Src/aht20.c **** 
  58:DeviceDrivers/Sensor/Src/aht20.c ****     /* 发送初始化命令后等待 AHT20 内部完成校准准备。 */
  59:DeviceDrivers/Sensor/Src/aht20.c ****     HAL_Delay(10U);
  60:DeviceDrivers/Sensor/Src/aht20.c **** 
