  87:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** {
ARM GAS  C:\Users\w1785\AppData\Local\Temp\ccCSADgC.s 			page 3


  88:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->x1 += x_ofs;
  89:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->x2 += x_ofs;
  90:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->y1 += y_ofs;
