  69:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** uint32_t lv_area_get_size(const lv_area_t * area_p)
  70:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** {
  71:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     uint32_t size;
  72:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** 
  73:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     size = (uint32_t)(area_p->x2 - area_p->x1 + 1) * (area_p->y2 - area_p->y1 + 1);
  74:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** 
  75:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     return size;
  76:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** }
  77:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** 
  78:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** void lv_area_increase(lv_area_t * area, int32_t w_extra, int32_t h_extra)
  79:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** {
  80:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->x1 -= w_extra;
  81:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->x2 += w_extra;
  82:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->y1 -= h_extra;
  83:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****     area->y2 += h_extra;
  84:Middlewares/LVGL/lvgl/src/misc/lv_area.c **** }
