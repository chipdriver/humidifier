 466:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****             points[i].y = (((int32_t)(points[i].y) * scale_y) >> 8) + pivot->y;
 467:Middlewares/LVGL/lvgl/src/misc/lv_area.c ****         }
