 162:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** /**
 163:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****  * Test if char is break char or not (a text can broken here or not)
 164:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****  * @param letter a letter
 165:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****  * @return false: 'letter' is not break char
 166:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****  */
 167:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** static inline bool lv_text_is_a_word(uint32_t letter)
 168:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** {
 169:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*Cheap check on invalid letter*/
 170:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter == 0) return false;
 171:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 172:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK Unified Ideographs*/
 173:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x4E00 && letter <= 0x9FFF) {
 174:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 175:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     }
 176:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 177:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*Fullwidth ASCII variants*/
 178:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0xFF01 && letter <= 0xFF5E) {
 179:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 180:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     }
 181:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 182:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK symbols and punctuation*/
 183:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x3000 && letter <= 0x303F) {
 184:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 185:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     }
 186:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 187:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK Radicals Supplement*/
 188:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x2E80 && letter <= 0x2EFF) {
 189:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 190:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     }
 191:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 192:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*CJK Strokes*/
 193:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     if(letter >= 0x31C0 && letter <= 0x31EF) {
 194:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         return true;
 195:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     }
 196:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
