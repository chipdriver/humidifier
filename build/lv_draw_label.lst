 146:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** static inline bool lv_text_is_break_char(uint32_t letter)
 147:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** {
 148:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     uint8_t i;
 149:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     bool ret = false;
 150:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 151:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     /*Compare the letter to TXT_BREAK_CHARS*/
 152:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     for(i = 0; LV_TXT_BREAK_CHARS[i] != '\0'; i++) {
 153:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         if(letter == (uint32_t)LV_TXT_BREAK_CHARS[i]) {
 154:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****             ret = true; /*If match then it is break char*/
 155:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****             break;
 156:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****         }
 157:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     }
 158:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** 
 159:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h ****     return ret;
 160:Middlewares/LVGL/lvgl/src/draw/../misc/lv_text_private.h **** }
